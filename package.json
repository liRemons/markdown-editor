{
  "name": "remons-markdown-editor",
  "version": "1.0.0-beta.25",
  "type": "module",
  "description": "一个可复用的 React Markdown 编辑器组件，支持工具栏、预览和自定义容器",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/liRemons/markdown-editor"
  },
  "homepage": "https://github.com/liRemons/markdown-editor#readme",
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode lib",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.12.0",
    "json5": "^2.2.3",
    "remons-markdown-plugins": "^2.0.0-beta.0",
    "remons-render-markdown": "^2.0.1-beta.4"
  },
  "peerDependencies": {
    "antd": ">=5.21.6",
    "@ant-design/icons": ">=5.0.0",
    "dayjs": ">=1.11.13",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "less": "^4.9.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "license": "MIT"
}
